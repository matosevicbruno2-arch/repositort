# --- Google OAuth (obavezno) ---
# Iz Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mora se doslovno poklapati s "Authorized redirect URI" u Google Cloud Console.
# Ako je prazno, koristi se BASE_URL + /auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Google tablica (obavezno) ---
# ID iz adrese tablice: docs.google.com/spreadsheets/d/<OVO_JE_ID>/edit
SHEET_ID=

# --- Sesija (obavezno) ---
# Nasumičan niz, npr. iz: openssl rand -hex 32
SESSION_SECRET=

# --- Pristup ---
# Popis e-mail adresa odvojenih zarezom koje se smiju prijaviti.
# Ako je prazno, prijaviti se može BILO KOJI Google račun — na javnom poslužitelju obavezno popuni.
ALLOWED_EMAILS=

# --- Chat "Pitaj Claudea" (neobavezno) ---
# Bez ključa aplikacija radi normalno, samo je gumb za chat skriven.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Poslužitelj ---
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# --- Potpis ispod opomene ---
SENDER_NAME=Bruno Matošević
SENDER_COMPANY=ELINK ICT, vl. Bruno Matošević
SENDER_PHONE=091 280 0903
SENDER_EMAIL=

# --- Trajna pohrana ---
# Refresh tokeni, registrirani uređaji i poslane obavijesti.
# Na hostingu mora pokazivati na trajni disk, inače se prijava gubi pri svakom
# ponovnom pokretanju, a push obavijesti prestaju raditi.
DB_PATH=./data/pult.db
# Ključ za šifriranje tokena u bazi (openssl rand -hex 32).
# Ako je prazno, koristi se SESSION_SECRET.
ENCRYPTION_KEY=

# --- iOS aplikacija i push obavijesti (neobavezno) ---
# Bez ovih postavki pult radi normalno, samo bez obavijesti.
# Vidi ios/README.md za vađenje ključa kod Applea.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=hr.elink.pult
# Sadržaj .p8 datoteke u jednom retku, novi redovi kao \n
APNS_KEY=
# 0 za build iz Xcodea, 1 za TestFlight i App Store
APNS_PRODUCTION=0
# Koliko često se provjerava kasne li računi (zadano 3 sata)
NOTIFY_INTERVAL_MS=10800000
# Shema kojom se aplikacija vraća s prijave
APP_SCHEME=elinkpult

# --- Fino podešavanje (neobavezno) ---
GMAIL_QUERY=in:inbox newer_than:7d
GMAIL_MAX_THREADS=40
CALENDAR_DAYS=7
TIME_ZONE=Europe/Zagreb
CACHE_TTL_MS=60000
